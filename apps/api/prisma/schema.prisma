generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssuerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminRole {
  OWNER
  SUPER_ADMIN
  ADMIN
  AUDITOR
}

enum RevocationReason {
  DATA_CORRECTION
  ISSUED_IN_ERROR
  FRAUD_SUSPECTED
  INSTITUTION_REQUEST
  OTHER
  LEGACY
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  /// No writer, deliberately: logout happens entirely in the web app, which
  /// clears the session cookie without calling the API. Nothing server-side
  /// observes it, so there is nothing to record. Recording it would mean
  /// adding a logout endpoint first.
  LOGOUT
  ADMIN_CREATED
  ADMIN_UPDATED
  ADMIN_DISABLED
  ADMIN_DELETED
  ADMIN_ROLE_CHANGED
  /// No writer, and this one marks a missing feature rather than a missing
  /// log line: there is no change-password endpoint anywhere in the API, so
  /// the only way to change an admin password is direct database access. The
  /// session invalidation it would need already exists (tokenVersion). Kept
  /// as the record of a known gap.
  ADMIN_PASSWORD_CHANGED
  CREDENTIAL_ISSUED
  CREDENTIAL_REVOKED
  CREDENTIAL_DELETED
  DOCUMENT_PROOF_CREATED
  DOCUMENT_PROOF_DELETED
  SIGNING_KEY_GENERATED
  SIGNING_KEY_ROTATED
  SETTINGS_UPDATED
  FORBIDDEN_ATTEMPT
}

enum VerificationResult {
  VALID
  INVALID
  REVOKED
  NOT_FOUND
}

enum VerificationMode {
  CORE_REGISTRY
  SECURE_PDF
}

enum IssuanceBatchSourceType {
  CSV
  API
}

enum CredentialDocumentProofSourceType {
  SINGLE_PDF
  BATCH_ZIP
}

enum CredentialDocumentProofStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum VerificationEventType {
  REGISTRY_CODE_LOOKUP
  QR_LOOKUP
  PDF_INTEGRITY_CHECK
}

enum DocumentProofVerificationSource {
  CODE_LOOKUP
  QR_LOOKUP
  PDF_UPLOAD
}

model Issuer {
  id             String                @id @default(cuid())
  name           String
  displayName    String?
  domain         String                @unique
  logoUrl        String?
  websiteUrl     String?
  wallet         String?               @unique
  status         IssuerStatus          @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  credentials    Credential[]
  admins         Admin[]
  batches        IssuanceBatch[]
  documentProofs SecureDocumentProof[]
  signingKeys    IssuerSigningKey[]

}

model IssuerSigningKey {
  id                  String       @id @default(cuid())
  issuerId            String
  issuer              Issuer       @relation(fields: [issuerId], references: [id])
  keyId               String       @unique
  publicKey           String
  privateKeyEncrypted String
  algorithm           String       @default("Ed25519")
  createdAt           DateTime     @default(now())
  revokedAt           DateTime?
  active              Boolean      @default(true)
  credentials         Credential[]

  @@index([issuerId])
  @@index([active])
}

model Credential {
  id                        String                    @id @default(cuid())
  credentialExternalId      String                    @unique
  verificationId            String                    @unique
  verificationCode          String                    @unique
  signedVerificationToken   String                    @unique
  qrPayload                 String
  verificationMode          VerificationMode          @default(CORE_REGISTRY)
  securePdfEnabled          Boolean                   @default(false)
  studentName               String
  studentId                 String
  degree                    String
  graduationYear            Int?
  metadataUri               String
  metadataJson              Json
  qrCodeUri                 String
  certificateUri            String?
  verificationUrl           String
  hash                      String                    @unique
  registryHash              String                    @unique
  chainProofHash            String                    @unique
  documentHash              String?                   @unique
  fileName                  String?
  mimeType                  String?
  fileSize                  Int?
  txHash                    String?
  revocationTxHash          String?
  chainId                   Int?
  anchoredAt                DateTime?
  blockNumber               Int?
  anchorStatus              String                    @default("PENDING")
  chainStatus               String                    @default("PENDING")
  chainSyncedAt             DateTime?
  anchorVersion             String                    @default("V1")
  issuerWallet              String?
  chainVerificationMetadata Json?
  publicPayload             String?
  signature                 String?
  signatureAlgorithm        String?                   @default("Ed25519")
  signedAt                  DateTime?
  signingKeyId              String?
  signingKey                IssuerSigningKey?         @relation(fields: [signingKeyId], references: [id])
  // W3C VC export (eddsa-jcs-2022). A separate signature from `signature`:
  // Data Integrity covers SHA-256(proof config) || SHA-256(canonical document),
  // not the `publicPayload` byte string. Signed by the same key at issuance.
  vcProofValue              String?
  vcProofCreated            DateTime?
  // The secured VC exactly as signed, proof included. Stored rather than rebuilt
  // per request because `issuer.domain` / `issuer.displayName` are editable, and
  // a rebuilt document would stop matching `vcProofValue` the moment either
  // changes — every previously issued VC would fail external verification with
  // no error on our side. Same reason `publicPayload` is stored verbatim.
  vcDocument                Json?
  revoked                   Boolean                   @default(false)
  revokedAt                 DateTime?
  revokedBy                 String?
  revokedByAdminId          String?
  revocationReason          RevocationReason?
  revocationNotes           String?
  deletedAt                 DateTime?
  deletedBy                 String?
  deletedByAdminId          String?
  verificationCount         Int                       @default(0)
  verifiedAt                DateTime?
  issuedAt                  DateTime                  @default(now())
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  issuerId                  String
  issuer                    Issuer                    @relation(fields: [issuerId], references: [id])
  batchId                   String?
  batch                     IssuanceBatch?            @relation(fields: [batchId], references: [id])
  documentProofs            CredentialDocumentProof[]
  verificationLogs          VerificationLog[]
  blockchainLogs            BlockchainAnchorLog[]

  @@index([issuerId])
  @@index([studentId])
  // A partial unique index on ("issuerId", "studentId", "degree") WHERE
  // "deletedAt" IS NULL AND "revoked" = false also exists on this table. It is
  // created in migration 20260727100000_credential_active_unique_index and has
  // no declarative equivalent here: Prisma cannot express partial indexes, and
  // a plain @@unique would block legitimate re-issuance after revocation.
  @@index([issuerId, studentId])
  @@index([batchId])
  @@index([anchorStatus])
  @@index([chainStatus])
  @@index([anchorVersion])
  @@index([deletedAt])
  @@index([signingKeyId])
}

model IssuanceBatch {
  id          String                  @id @default(cuid())
  issuerId    String
  issuer      Issuer                  @relation(fields: [issuerId], references: [id])
  uploadedBy  String
  sourceType  IssuanceBatchSourceType @default(CSV)
  totalRows   Int                     @default(0)
  issuedRows  Int                     @default(0)
  failedRows  Int                     @default(0)
  createdAt   DateTime                @default(now())
  anchoredAt  DateTime?
  txHash      String?
  credentials Credential[]

  @@index([issuerId])
  @@index([createdAt])
}

model CredentialDocumentProof {
  id           String                            @id @default(cuid())
  credentialId String
  credential   Credential                        @relation(fields: [credentialId], references: [id])
  hash         String
  algorithm    String                            @default("SHA-256")
  fileName     String
  fileSize     Int
  mimeType     String
  registeredAt DateTime                          @default(now())
  registeredBy String
  sourceType   CredentialDocumentProofSourceType
  status       CredentialDocumentProofStatus     @default(ACTIVE)

  @@unique([credentialId, hash])
  @@index([credentialId])
  @@index([hash])
  @@index([status])
}

model SecureDocumentProof {
  id                        String                               @id @default(cuid())
  proofExternalId           String                               @unique
  verificationId            String                               @unique
  verificationCode          String                               @unique
  signedVerificationToken   String                               @unique
  qrPayload                 String
  proofUrl                  String
  metadataUri               String
  qrCodeUri                 String
  title                     String
  documentType              String
  referenceNumber           String?
  documentDate              DateTime?
  fileName                  String
  mimeType                  String
  fileSize                  Int
  sourceHash                String                               @unique
  txHash                    String?
  chainId                   Int?
  anchoredAt                DateTime?
  blockNumber               Int?
  anchorStatus              String                               @default("PENDING")
  chainStatus               String                               @default("PENDING")
  chainSyncedAt             DateTime?
  anchorVersion             String                               @default("V2")
  issuerWallet              String?
  chainVerificationMetadata Json?
  revoked                   Boolean                              @default(false)
  revokedAt                 DateTime?
  revokedBy                 String?
  revokedByAdminId          String?
  revocationReason          RevocationReason?
  revocationNotes           String?
  verificationCount         Int                                  @default(0)
  verifiedAt                DateTime?
  createdBy                 String
  createdAt                 DateTime                             @default(now())
  updatedAt                 DateTime                             @updatedAt
  issuerId                  String
  issuer                    Issuer                               @relation(fields: [issuerId], references: [id])
  verificationLogs          SecureDocumentProofVerificationLog[]

  @@index([issuerId])
  @@index([anchorStatus])
  @@index([chainStatus])
}

model SecureDocumentProofVerificationLog {
  id              String                          @id @default(cuid())
  documentProofId String?
  documentProof   SecureDocumentProof?            @relation(fields: [documentProofId], references: [id])
  sourceType      DocumentProofVerificationSource @default(PDF_UPLOAD)
  uploadedHash    String?
  matched         Boolean                         @default(false)
  status          String
  ipAddress       String?
  createdAt       DateTime                        @default(now())

  @@index([documentProofId])
  @@index([createdAt])
  @@index([status])
}

model Admin {
  id           String    @id @default(cuid())
  username     String?   @unique
  email        String    @unique
  password     String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  tokenVersion Int       @default(0)
  issuerId     String?
  issuer       Issuer?   @relation(fields: [issuerId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([issuerId])
}

model VerificationLog {
  id           String                @id @default(cuid())
  credentialId String?
  credential   Credential?           @relation(fields: [credentialId], references: [id])
  eventType    VerificationEventType @default(REGISTRY_CODE_LOOKUP)
  uploadedHash String?
  matched      Boolean               @default(false)
  status       String
  ipAddress    String?
  createdAt    DateTime              @default(now())

  @@index([credentialId])
  @@index([createdAt])
  @@index([status])
  @@index([credentialId, createdAt])
}

// Append-only: one row per lifecycle event. Never updated or deleted; the
// credential's current anchor state lives on the Credential row, this table is
// the immutable history. (2.1)
model BlockchainAnchorLog {
  id           String     @id @default(cuid())
  credentialId String
  operation    String
  status       String
  txHash       String?
  chainId      Int?
  blockNumber  Int?
  attempts     Int        @default(0)
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  credential   Credential @relation(fields: [credentialId], references: [id])

  @@index([credentialId])
  @@index([credentialId, createdAt])
  @@index([status])
  @@index([operation])
  @@index([createdAt])
}

// Tamper-evident: each new row is hash-chained to the previous one via
// prevHash -> entryHash, so any edit or deletion breaks the chain and is
// detectable by verifyChain(). Legacy rows (pre-chain) have null entryHash. (2.2)
model AuditLog {
  id            String      @id @default(cuid())
  seq           Int         @unique @default(autoincrement())
  action        AuditAction
  actorAdminId  String?
  actorUsername String?
  targetType    String?
  targetId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  prevHash      String?
  entryHash     String?     @unique
  createdAt     DateTime    @default(now())

  @@index([actorAdminId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}

/// The chain head, kept in its own table so that truncating or deleting from
/// the tail of AuditLog is detectable. A chain that only checks row N against
/// row N-1 stays perfectly continuous after its last rows are removed, and is
/// vacuously valid once the table is empty — the head is the anchor that makes
/// both visible. Always exactly one row, id "singleton".
model AuditChainHead {
  id        String   @id @default("singleton")
  seq       Int
  entryHash String
  updatedAt DateTime @updatedAt
}
