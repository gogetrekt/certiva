# ─────────────────────────────────────────────────────────────────────────────
# Certiva self-host config. Copy to `.env`, fill in the REQUIRED values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
# Hostnames (postgres/redis/api) resolve on the compose network — leave as-is
# unless you run those services elsewhere.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
APP_ENV=production
PORT=4000
WEB_PORT=3000

# ── Postgres (used by both the DB container and DATABASE_URL) ────────────────
POSTGRES_USER=certiva
POSTGRES_PASSWORD=            # REQUIRED — pick a strong password
POSTGRES_DB=certiva
DATABASE_URL=postgresql://certiva:CHANGE_ME@postgres:5432/certiva?schema=public

# ── Redis (rate-limit store + anchor queue) ──────────────────────────────────
REDIS_URL=redis://redis:6379
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_PREFIX=certiva:rl:

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                   # REQUIRED — must be >= 64 chars (openssl rand -hex 48)
JWT_EXPIRES_IN=1h
COOKIE_SECURE=true            # true when served over HTTPS
TRUST_PROXY=true              # true when behind a reverse proxy / load balancer

# ── Public URLs & CORS (use your real domains) ───────────────────────────────
WEB_PUBLIC_BASE_URL=https://verify.your-univ.ac.id
API_PUBLIC_BASE_URL=https://verify.your-univ.ac.id
CORS_ORIGINS=https://verify.your-univ.ac.id
INTERNAL_API_URL=http://api:4000/api    # web BFF -> api over the compose network (note /api prefix)
NEXT_PUBLIC_SITE_URL=https://verify.your-univ.ac.id   # baked into the web build
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-univ.ac.id     # baked into the web build

# ── Asset storage — Cloudflare R2 is REQUIRED in production ──────────────────
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_FORCE_PATH_STYLE=true

# ── Blockchain anchoring (optional — set BLOCKCHAIN_ENABLED=false to skip) ────
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_TIMEOUT_MS=15000
POLYGON_AMOY_RPC_URL=
CONTRACT_ADDRESS=
ISSUER_WALLET=
PRIVATE_KEY=                  # anchoring wallet key — keep secret, never commit

# ── Rate limits (sane defaults; tune if needed) ──────────────────────────────
RATE_LIMIT_VERIFY_MAX=30
RATE_LIMIT_VERIFY_WINDOW_SECONDS=60
RATE_LIMIT_VERIFY_UPLOAD_MAX=10
RATE_LIMIT_VERIFY_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LOGIN_MAX=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_MAX=120
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
